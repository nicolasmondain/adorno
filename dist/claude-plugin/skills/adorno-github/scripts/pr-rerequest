#!/usr/bin/env bash
# Usage: pr-rerequest owner/repo#123 [login ...]
# Asks reviewers to look again, and only those who are waited for: a reviewer is re-requested when
#   - their latest decisive review (APPROVED, CHANGES_REQUESTED, DISMISSED; COMMENTED does not count) requested changes,
#   - they are not already requested,
#   - and since that review the head moved (a commit was pushed) or you replied: a PR comment, a review, or a reply
#     in a thread they took part in.
# Without names: every human who reviewed is checked; with names: only those. A team is never re-requested (a team
# never requests changes itself). Nobody eligible: nothing is sent, exit 0.
# Prints {requested: [login], skipped: [{login, reason}]}. Needs L3. ADORNO_DRY_RUN=1 only prints.
. "$(dirname "$0")/_lib.sh"

parse_ref "${1:-}"
shift || true
require_level "$REPO" L3 rerequest

for l in "$@"; do
  [[ "$l" =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)?$ ]] || die "invalid reviewer '$l'" "$E_USAGE"
done
names=null
[ $# -eq 0 ] || names="$(printf '%s\n' "$@" | jq -R . | jq -sc .)"

query='query PrRerequest($owner:String!,$name:String!,$num:Int!){
  viewer{ login }
  repository(owner:$owner, name:$name){ pullRequest(number:$num){
    headRefOid
    reviewRequests(first:50){ nodes{ requestedReviewer{ ... on User{login} ... on Team{slug} } } }
    reviews(last:100){ nodes{ author{ login __typename } state submittedAt commit{ oid } } }
    comments(last:100){ nodes{ author{ login } createdAt } }
    reviewThreads(last:100){ nodes{ comments(last:50){ nodes{ author{ login } createdAt } } } } } } }'

plan="$(gh api graphql -f query="$query" -F owner="$OWNER" -F name="$NAME" -F num="$NUM" \
| jq -c --argjson names "$names" '
  .data.viewer.login as $me
  | .data.repository.pullRequest as $p
  | [$p.reviewRequests.nodes[].requestedReviewer.login // empty] as $waiting
  | ([$p.comments.nodes[] | select(.author.login == $me) | .createdAt]
     + [$p.reviews.nodes[] | select(.author.login == $me) | .submittedAt]) as $mineOnPr
  | def mine($l): $mineOnPr + [$p.reviewThreads.nodes[].comments.nodes
        | select(any(.[]; .author.login == $l)) | .[] | select(.author.login == $me) | .createdAt];
    ($names // [$p.reviews.nodes[] | select(.author.__typename == "User" and .author.login != $me) | .author.login]
     | unique) as $who
  | [ $who[] as $l
      | if ($l | contains("/")) then {login: $l, reason: "team"}
        else ([$p.reviews.nodes[] | select(.author.login == $l and (.state == "APPROVED" or
                 .state == "CHANGES_REQUESTED" or .state == "DISMISSED"))] | sort_by(.submittedAt) | last) as $r
        | if $r == null or $r.state == "DISMISSED" then {login: $l, reason: "no changes requested"}
          elif $r.state == "APPROVED" then {login: $l, reason: "approved"}
          elif ($waiting | index($l)) != null then {login: $l, reason: "already requested"}
          elif ($r.commit.oid // "") != $p.headRefOid or any(mine($l)[]; . > $r.submittedAt) then {login: $l}
          else {login: $l, reason: "nothing new since the review"} end
        end ]
  | {requested: [.[] | select(.reason == null) | .login], skipped: [.[] | select(.reason != null)]}')"

if dry_run; then
  jq '{dryRun: true, action: "rerequest"} + .' <<<"$plan"
  exit 0
fi
[ "$(jq '.requested | length' <<<"$plan")" -gt 0 ] || { printf '%s\n' "$plan"; exit 0; }

args=()
while IFS= read -r l; do args+=(-f "reviewers[]=$l"); done < <(jq -r '.requested[]' <<<"$plan")
gh api -X POST "repos/$REPO/pulls/$NUM/requested_reviewers" "${args[@]}" >/dev/null
journal_github rerequest "$REPO#$NUM"
printf '%s\n' "$plan"
