#!/usr/bin/env bash
# Usage: pr-shortcuts DIFF_FILE
# The `shortcut:` comments (and older `ponytail:` ones, skill ponytail-debt) that a diff adds: the shortcuts ledger of a
# branch or a PR. Only added lines count; the line is the one of the new file. Comment prefixes: `#`, `//`, `/*` (JSX
# `{/* */}` too), `<!--` and a JSDoc ` * ` line. Whether a marker names its limit and its trigger is left to the reader.
# Prints JSON {shortcuts: [{file, line, text}], count}.
. "$(dirname "$0")/_lib.sh"

diff="${1:-}"
[ -f "$diff" ] || die "usage: pr-shortcuts DIFF_FILE" "$E_USAGE"

# `path<TAB>line<TAB>text` per added marker: the path from the `--- a/x` / `+++ b/y` headers (git quotes names with
# special or non-ASCII characters), the line counted from the `@@ -a,b +c,d @@` hunk headers
awk '
  function unq(p) { if (p ~ /^".*"$/) { p = substr(p, 2, length(p) - 2) } return p }
  /^diff --git / { old = ""; f = ""; inhdr = 1; next }
  inhdr && /^--- / { old = unq(substr($0, 5)); sub(/^a\//, "", old); next }
  inhdr && /^\+\+\+ / { f = unq(substr($0, 5)); sub(/^b\//, "", f); if (f == "/dev/null") f = old; inhdr = 0; next }
  /^@@ / { h = $0; sub(/^@@ -[0-9,]+ \+/, "", h); sub(/[^0-9].*$/, "", h); n = h + 0; inhdr = 0; next }
  /^\+/ {
    t = substr($0, 2)
    if (f != "" && t ~ /(#|\/\/|\/[*]|<!--|^[[:space:]]*[*]) ?(shortcut|ponytail):/) {
      sub(/^[[:space:]]+/, "", t); print f "\t" n "\t" t
    }
    n++; next
  }
  /^ / { n++ }
' "$diff" | while IFS= read -r l; do
  # decode git's octal escapes in the path (\303\251 -> é)
  f="${l%%$'\t'*}"
  case "$f" in *\\[0-7][0-7][0-7]*) f="$(printf '%b' "$(printf '%s' "$f" | sed 's/\\\([0-7][0-7][0-7]\)/\\0\1/g')")" ;; esac
  printf '%s\t%s\n' "$f" "${l#*$'\t'}"
done | jq -R -s '
  [split("\n")[] | select(length > 0) | capture("^(?<file>[^\t]*)\t(?<line>[0-9]+)\t(?<text>.*)$") | .line |= tonumber]
  | {shortcuts: ., count: length}'
