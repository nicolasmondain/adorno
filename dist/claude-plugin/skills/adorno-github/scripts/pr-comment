#!/usr/bin/env bash
# Usage: pr-comment owner/repo#N BODY_FILE   (BODY_FILE = - reads stdin)
# Posts a comment on the PR conversation (to answer a general comment or a review summary).
# Needs L3. GH_OPS_DRY_RUN=1 prints the comment instead of posting it.
. "$(dirname "$0")/_lib.sh"

parse_ref "${1:-}"
file="${2:-}"
[ -n "$file" ] || die "usage: pr-comment owner/repo#N BODY_FILE|-" "$E_USAGE"
require_level "$REPO" L3 comment

if [ "$file" = "-" ]; then file="$(work_dir)/comment-$$.md"; cat >"$file"; fi
[ -s "$file" ] || die "empty comment body" "$E_USAGE"
file="$(with_footer "$REPO" "$file")"

if dry_run; then
  jq -n --rawfile body "$file" '{dryRun: true, action: "comment", body: $body}'
  exit 0
fi
url="$(gh pr comment "$NUM" -R "$REPO" --body-file "$file")"
jq -n --arg url "$url" '{posted: true, url: $url}'
