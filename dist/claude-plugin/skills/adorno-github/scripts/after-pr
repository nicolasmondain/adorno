#!/usr/bin/env bash
# Usage: after-pr plan RUN_DIR [owner/repo] --pr-url URL --workflow ID [--force]
#        after-pr done SKILL RUN_DIR
# Repo skills to run once a PR exists (`after_pr` in local/adorno.yaml), for the workflow of the run being shipped:
# e.g. fill the Notion ticket after `workflow:issue:fix`. This script only decides; the agent runs each skill
# (workflow:pr:ship), then records it with `done`.
#   plan → {pr_url, dry_run, skills: [{skill, args}]}: the entries whose `workflows` holds --workflow (the workflow of
#          the run being shipped, as given to run-begin: it must be one of this session's active runs on the repo,
#          else exit 5), whose `needs` is met (`notion`: the request has a Notion page in RUN_DIR/refs.json), and not
#          already done for this run (RUN_DIR/after-pr.json; --force plans them again).
#          `args` = [PR URL] + [the first Notion page's URL, rebuilt from its id] when the request has one.
#          Or {skip: reason} when nothing applies.
#   done → appends {skill, at, args} to RUN_DIR/after-pr.json once the skill has run.
# No level above the run's: the repo config is the opt-in. Never outside a run (exit 5); a report or L0 run makes
# dry_run true: the skill is shown, not run.
. "$(dirname "$0")/_lib.sh"

usage="usage: after-pr plan RUN_DIR [owner/repo] --pr-url URL --workflow ID [--force] | done SKILL RUN_DIR"
cmd="${1:-}"
case "$cmd" in plan|done) ;; *) die "$usage" "$E_USAGE" ;; esac
skill="" dir=""
if [ "$cmd" = "done" ]; then skill="${2:-}"; dir="${3:-}"; shift $(( $# < 3 ? $# : 3 ))
else dir="${2:-}"; shift $(( $# < 2 ? $# : 2 )); fi
[ -n "$dir" ] && [ -d "$dir" ] || die "run folder not found: '${dir}'" "$E_USAGE"
log_file="$dir/after-pr.json" planned="$dir/.after-pr.json"
[ "$cmd" = "done" ] || rm -f "$planned"   # `done` records only what this plan returns, even if it fails below

if [ "$cmd" = "done" ]; then
  [ -f "$planned" ] || die "nothing planned in $dir: run after-pr plan first" "$E_USAGE"
  ! jq -e '.dry_run' "$planned" >/dev/null || die "the plan was a dry run: nothing ran to record" "$E_USAGE"
  entry="$(jq -c --arg s "$skill" '.skills | map(select(.skill == $s)) | first // empty' "$planned")"
  [ -n "$entry" ] || die "'$skill' is not in the plan of $dir" "$E_USAGE"
  [ -f "$log_file" ] || echo '[]' >"$log_file"
  jq --argjson e "$entry" '. + [$e + {at: (now | todate)}]' "$log_file" >"$log_file.tmp"
  mv "$log_file.tmp" "$log_file"
  jq --arg s "$skill" '.skills |= map(select(.skill != $s))' "$planned" >"$planned.tmp"
  mv "$planned.tmp" "$planned"
  jq --arg s "$skill" 'map(select(.skill == $s)) | last' "$log_file"
  exit 0
fi

repo="" pr_url="" workflow="" force=false
while [ $# -gt 0 ]; do
  case "$1" in
    --pr-url)
      [[ "${2:-}" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/[0-9]+$ ]] \
        || die "--pr-url: a GitHub PR URL (https://github.com/owner/repo/pull/N)" "$E_USAGE"
      pr_url="$2"; shift 2 ;;
    --workflow)
      [[ "${2:-}" =~ ^[a-z0-9:_-]+$ ]] || die "--workflow: the workflow id of the run, like workflow:issue:fix" "$E_USAGE"
      workflow="$2"; shift 2 ;;
    --force) force=true; shift ;;
    -*) die "unknown option $1" "$E_USAGE" ;;
    *) [ -z "$repo" ] || die "$usage" "$E_USAGE"; repo="$1"; shift ;;
  esac
done
[ -n "$pr_url" ] || die "--pr-url is required" "$E_USAGE"
[ -n "$workflow" ] || die "--workflow is required (the workflow of the run being shipped, as given to run-begin)" "$E_USAGE"

skip() { jq -n --arg r "$1" '{skip: $r}'; exit 0; }
split_repo "${repo:-$(current_repo)}"
g="$(grant "$REPO")"
[ "$(jq -r .runs <<<"$g")" != 0 ] || die "no active run covers $REPO: start the workflow with run-begin" "$E_LEVEL"
jq -e --arg w "$workflow" '.workflows | index($w)' <<<"$g" >/dev/null \
  || die "$workflow is not the workflow of an active run of this session on $REPO (active: $(jq -r '.ids | join(", ")' <<<"$g"))" "$E_LEVEL"
entries="$(repo_conf "$REPO" | jq -c '.after_pr // []')"
[ "$entries" != "[]" ] || skip "$REPO sets no after_pr"

refs="$dir/refs.json"
notion=""   # rebuilt from the parsed page id: the URL in refs.json is untrusted request text
if [ -f "$refs" ]; then
  notion="$(jq -r '[.refs[]? | select(.kind == "notion")] | first | .page_id // empty
    | select(test("^[0-9a-f-]{32,36}$")) | "https://www.notion.so/" + gsub("-"; "")' "$refs")" || die "cannot read $refs"
fi
done_skills="[]"
if ! $force && [ -f "$log_file" ]; then done_skills="$(jq -c 'map(.skill)' "$log_file")"; fi

plan="$(jq -n --argjson e "$entries" --argjson g "$g" --argjson done "$done_skills" --arg pr "$pr_url" \
  --arg w "$workflow" --arg notion "$notion" '
  {pr_url: $pr, dry_run: ($g.dry_run or $g.level == "L0"),
   skills: [$e[] | select(.workflows | index($w))
                 | select((.needs // "") != "notion" or $notion != "")
                 | select(.skill as $s | $done | index($s) | not)
                 | {skill, args: ([$pr] + (if $notion != "" then [$notion] else [] end))}]}')"
[ "$(jq '.skills | length' <<<"$plan")" != 0 ] || skip "no after_pr entry applies to $workflow on $REPO (listed workflows, Notion page, or already done for this run)"
printf '%s\n' "$plan" | tee "$planned"
