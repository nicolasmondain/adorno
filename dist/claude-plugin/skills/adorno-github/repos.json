{
  "defaults": {
    "base": null,
    "branch_pattern": "^(feat|fix|perf|refactor|test|docs|style|build|ci|chore|revert)/[a-z0-9]+(-[a-z0-9]+)*$",
    "resolve_threads": "author",
    "reply_language": "en",
    "max_level": "L3",
    "ponytail": "full",
    "review_checks": "none",
    "allow_approve": false,
    "max_inline": 8,
    "max_parallel": 3,
    "commit_skill": "adorno-commit",
    "pr_skill": "adorno-pr-open",
    "permissions": {
      "deny": [],
      "claude": {
        "deny": [
          "Bash(gh pr comment:*)",
          "Bash(gh pr review:*)",
          "Bash(gh pr merge:*)",
          "Bash(gh pr close:*)",
          "Bash(gh issue comment:*)",
          "Bash(gh issue create:*)",
          "Bash(gh release:*)",
          "Edit(~/.adorno/registry.json)",
          "Write(~/.adorno/registry.json)",
          "Edit(~/.adorno/runs/active/**)",
          "Write(~/.adorno/runs/active/**)"
        ]
      }
    },
    "impact": {
      "window": "7d",
      "min_age": "3d",
      "environment": "production",
      "post": "comment",
      "post_public": false,
      "sources": []
    },
    "areas": {
      "always": {
        "review": [
          "agent:review:code",
          "agent:review:ponytail"
        ]
      },
      "front": {
        "paths": [
          "*.tsx",
          "*.jsx",
          "*.vue",
          "*.svelte",
          "*.css",
          "*.scss",
          "*.less",
          "*.html",
          "client/*",
          "*/client/*",
          "*/ui/*",
          "*/components/*",
          "*/pages/*"
        ],
        "build": "agent:feat:front",
        "fix": "agent:fix:patch",
        "perf": "agent:perf:front",
        "review": [
          "agent:review:front",
          "agent:review:perf"
        ],
        "qa": "agent:test:e2e",
        "skills": [
          "frontend-ui-engineering"
        ]
      },
      "back": {
        "paths": [
          "server/*",
          "*/server/*",
          "*/services/*",
          "*/jobs/*",
          "*/workers/*",
          "*/lib/*"
        ],
        "build": "agent:feat:back",
        "fix": "agent:fix:patch",
        "perf": "agent:perf:nodejs",
        "review": [
          "agent:review:back",
          "agent:review:tests",
          "agent:review:perf-back"
        ],
        "sub": {
          "query": {
            "content": "\\.aggregate\\(|\\.find(One)?\\(|\\.(update|delete|insert)(One|Many)?\\(|\\.bulkWrite\\(|rawCollection\\(|\\$lookup|\\$match|\\$group",
            "perf": "agent:perf:mongodb",
            "review": [
              "agent:review:mongodb"
            ]
          },
          "mongodb": {
            "paths": [
              "*/migrations/*",
              "*migration*",
              "*/collections/*",
              "*/models/*"
            ],
            "content": "\\.createIndex\\(|Mongo\\.Collection|new Schema\\(",
            "perf": "agent:perf:mongodb",
            "review": [
              "agent:review:mongodb"
            ],
            "skills": [
              "deprecation-and-migration"
            ]
          }
        }
      },
      "api": {
        "paths": [
          "*/api/*",
          "*/routes/*",
          "*/methods/*",
          "*openapi*",
          "*/api-reference/*"
        ],
        "build": "agent:feat:api",
        "review": [
          "agent:review:api"
        ],
        "skills": [
          "api-and-interface-design"
        ]
      },
      "security": {
        "paths": [
          "*/auth/*",
          "*/permissions/*",
          "*.env*"
        ],
        "content": "(password|secret|token|api[_-]?key|jwt|bcrypt|crypto\\.|permission|isAdmin|role)",
        "fix": "agent:fix:security",
        "review": [
          "agent:review:security"
        ],
        "skills": [
          "security-and-hardening"
        ]
      },
      "typescript": {
        "paths": [
          "*.ts",
          "*.tsx",
          "*.mts",
          "*.cts",
          "tsconfig*.json"
        ],
        "skills": [
          "typescript-pro"
        ]
      },
      "tests": {
        "paths": [
          "*.test.*",
          "*.spec.*",
          "*/tests/*",
          "*/__tests__/*",
          "*/test/*"
        ],
        "build": "agent:test:unit",
        "fix": "agent:test:unit",
        "review": [
          "agent:review:tests"
        ],
        "skills": [
          "test-driven-development"
        ]
      },
      "e2e": {
        "paths": [
          "*.e2e.*",
          "*/e2e/*",
          "*playwright*"
        ],
        "build": "agent:test:e2e",
        "fix": "agent:test:e2e",
        "review": [
          "agent:review:tests"
        ],
        "skills": [
          "webapp-testing",
          "playwright-cli"
        ]
      },
      "deps": {
        "paths": [
          "package.json",
          "*/package.json",
          "*lock.json",
          "*.lock",
          "yarn.lock",
          "requirements*.txt",
          "go.mod"
        ],
        "build": "agent:chore:deps",
        "fix": "agent:chore:deps",
        "review": [
          "agent:review:security",
          "agent:review:ponytail"
        ]
      },
      "ci": {
        "paths": [
          ".github/*",
          "*Dockerfile*",
          "*docker-compose*"
        ],
        "fix": "agent:ci:fix",
        "review": [
          "agent:review:security"
        ],
        "skills": [
          "ci-cd-and-automation"
        ]
      },
      "docs": {
        "paths": [
          "*.md",
          "*.mdx",
          "docs/*"
        ],
        "build": "agent:docs:write",
        "fix": "agent:docs:write",
        "skills": [
          "documentation-and-adrs"
        ]
      }
    },
    "fallbacks": {
      "nit": "agent:refactor:simplify",
      "test": "agent:test:unit",
      "perf": {
        "agent": "agent:fix:patch",
        "skills": [
          "performance-optimization"
        ]
      }
    }
  },
  "repos": {}
}
