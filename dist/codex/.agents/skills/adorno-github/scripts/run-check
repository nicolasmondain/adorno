#!/usr/bin/env bash
# Usage: run-check owner/repo|--dir PATH LEVEL [action] [--pr N] [--work-branch]
# Read-only: would a write at LEVEL (and ACTION) be allowed on this repo right now? Same rules as every write script
# (require_level: the repo's max_level and permissions.deny, the active run of this session, its denied actions),
# plus: a dry-run run allows nothing. With --dir, the repo is the GitHub origin of the git repository at PATH. With
# --pr N, PR N must also be yours, open and not from a fork (require_own_open_pr, as pr-edit and pr-ready). With
# --work-branch (needs --dir), the checkout must be on a working branch: never detached, the base or a shared one.
# Used by guard_bash.py to let a repo's own commit or PR skill commit and run `gh pr create|edit|ready` without a
# prompt in a run. Prints {allowed, repo, level, action}; exit 0 if allowed, else the code of the refusal (4 policy,
# 5 level).
. "$(dirname "$0")/_lib.sh"

dir=""
if [ "${1:-}" = "--dir" ]; then
  [ -d "${2:-}" ] || die "no such directory: ${2:-}" "$E_USAGE"
  dir="$2"; split_repo "$(cd "$2" && current_repo)"; shift 2
else
  split_repo "${1:-}"; shift || true
fi
level="" action="" pr="" work=false
while [ $# -gt 0 ]; do
  case "$1" in
    --pr) pr="${2:-}"; [[ "$pr" =~ ^[0-9]+$ ]] || die "--pr: a PR number" "$E_USAGE"; shift 2 ;;
    --work-branch) work=true; shift ;;
    -*) die "unknown option $1" "$E_USAGE" ;;
    *) if [ -z "$level" ]; then level="$1"; else action="$1"; fi; shift ;;
  esac
done
case "$level" in L0|L1|L2|L3) ;; *) die "LEVEL: L0..L3" "$E_USAGE" ;; esac
require_level "$REPO" "$level" "$action"
! dry_run || die "the active run is a dry run: nothing leaves the machine" "$E_POLICY"
[ -z "$pr" ] || require_own_open_pr "$REPO" "$pr" >/dev/null
if [ "$work" = true ]; then
  [ -n "$dir" ] || die "--work-branch needs --dir" "$E_USAGE"
  require_work_branch "$REPO" "$(git -C "$dir" symbolic-ref --short -q HEAD || true)"
fi
jq -n --arg r "$REPO" --arg l "$level" --arg a "$action" --arg p "$pr" \
  '{allowed: true, repo: $r, level: $l, action: $a} + (if $p == "" then {} else {pr: ($p | tonumber)} end)'
