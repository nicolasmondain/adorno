#!/usr/bin/env bash
# Usage: learn-note --key SLUG --kind tech|product|code|process|voice|personality --target FILE[#section]
#                   --observation TEXT --proposal TEXT [--evidence URL|file:line]… [--strength explicit|inferred]
# Records a candidate adjustment of the owner's profile in ~/.adorno/learn/candidates.json. The same --key seen again
# adds its evidence and bumps `seen` instead of creating a duplicate; a key the owner rejected stays rejected.
# Prints the candidate. Never touches the profile itself.
set -euo pipefail
SELF="$(basename "$0")"
die() { printf '%s: %s\n' "$SELF" "$1" >&2; exit "${2:-1}"; }
command -v jq >/dev/null 2>&1 || die "missing dependency: jq"

key="" kind="" target="" obs="" prop="" strength="inferred"; ev=()
while [ $# -gt 0 ]; do
  case "$1" in
    --key) key="${2:-}"; shift 2 ;;
    --kind) kind="${2:-}"; shift 2 ;;
    --target) target="${2:-}"; shift 2 ;;
    --observation) obs="${2:-}"; shift 2 ;;
    --proposal) prop="${2:-}"; shift 2 ;;
    --evidence) ev+=("${2:-}"); shift 2 ;;
    --strength) strength="${2:-}"; shift 2 ;;
    *) die "unknown option $1" 2 ;;
  esac
done
[[ "$key" =~ ^[a-z0-9][a-z0-9-]{2,60}$ ]] || die "--key: a short slug (a-z, 0-9, -)" 2
case "$kind" in tech|product|code|process|voice|personality) ;; *) die "--kind: tech, product, code, process, voice or personality" 2 ;; esac
case "$strength" in explicit|inferred) ;; *) die "--strength: explicit (the owner said it) or inferred" 2 ;; esac
[ -n "$target" ] && [ -n "$obs" ] && [ -n "$prop" ] || die "--target, --observation and --proposal are required" 2
[ ${#ev[@]} -gt 0 ] || die "at least one --evidence (a link or file:line): no candidate without proof" 2

dir="${ADORNO_HOME:-$HOME/.adorno}/learn"; mkdir -p "$dir"; f="$dir/candidates.json"
[ -f "$f" ] || printf '{}\n' >"$f"
now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
jq --arg k "$key" --arg kind "$kind" --arg t "$target" --arg o "$obs" --arg p "$prop" --arg s "$strength" \
   --arg now "$now" --args '
  ($ARGS.positional) as $ev
  | if .[$k] == null then
      .[$k] = {key: $k, kind: $kind, target: $t, observation: $o, proposal: $p, strength: $s,
               evidence: $ev, seen: 1, first: $now, last: $now, status: "pending"}
    else
      .[$k] |= (.seen += 1 | .last = $now | .evidence = ((.evidence + $ev) | unique)
                | if $s == "explicit" then .strength = "explicit" | .proposal = $p else . end)
    end' "${ev[@]}" <"$f" >"$f.tmp" && mv "$f.tmp" "$f"
jq --arg k "$key" '.[$k]' "$f"
