{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "adorno run journal: one event per line of events.jsonl and enriched.jsonl",
  "type": "object",
  "required": ["v", "t", "run", "session", "actor", "parent", "type"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1},
    "t": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "run": {"type": "string", "pattern": "^[0-9T]+-[0-9]+-[0-9]+$"},
    "session": {"type": "string"},
    "actor": {"type": "string", "pattern": "^(you|session|agent:[A-Za-z0-9_.-]+)$"},
    "parent": {"type": ["string", "null"], "pattern": "^session$"},
    "type": {"enum": ["run.begin", "run.end", "step.begin", "step.end", "agent.spawn", "agent.return", "model.turn",
                      "tool.call", "script.call", "guard", "message", "checkpoint", "finding", "loop", "github",
                      "session"]},
    "dur": {"type": "integer", "minimum": 0},

    "workflow": {"type": "string"},
    "mode": {"type": "string"},
    "level": {"type": "string", "pattern": "^L[0-4]$"},
    "repos": {"type": "array", "items": {"type": "string"}},
    "dir": {"type": "string"},
    "deny": {"type": "array", "items": {"type": "string"}},
    "dry_run": {"type": "boolean"},
    "outcome": {"type": "string"},

    "index": {"type": "integer", "minimum": 0},
    "name": {"type": "string"},
    "round": {"type": "integer", "minimum": 1},
    "cap": {"type": "integer", "minimum": 1},

    "agent": {"type": "object", "required": ["id"], "additionalProperties": false,
              "properties": {"id": {"type": "string"}, "type": {"type": "string"}}},
    "model": {"type": "string"},
    "tokens": {"type": "object", "required": ["in", "out", "cache_read", "cache_write"], "additionalProperties": false,
               "properties": {"in": {"type": "integer", "minimum": 0}, "out": {"type": "integer", "minimum": 0},
                              "cache_read": {"type": "integer", "minimum": 0},
                              "cache_write": {"type": "integer", "minimum": 0}}},
    "thinking_tokens": {"type": "integer", "minimum": 0},
    "thinking_ms": {"type": "integer", "minimum": 0},
    "stop": {"type": "string"},
    "reasoning": {"type": "string"},
    "transcript": {"type": "string"},

    "excerpt": {"type": "string"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chars": {"type": "integer", "minimum": 0},
    "ref": {"type": "object", "required": ["file"], "additionalProperties": false,
            "properties": {"file": {"type": "string"}, "id": {"type": "string"}}},

    "tool": {"type": "string"},
    "input": {"type": "string"},
    "exit": {"type": "integer"},
    "error": {"type": "boolean"},
    "script": {"type": "string"},
    "args": {"type": "array", "items": {"type": "string"}},
    "action": {"type": "string"},

    "decision": {"enum": ["deny", "ask"]},
    "reason": {"type": "string"},
    "command": {"type": "string"},

    "from": {"type": "string"},
    "to": {"type": "string"},
    "kind": {"type": "string"},
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "by": {"type": "string"},

    "reviewer": {"type": "string"},
    "severity": {"enum": ["blocker", "major", "minor", "question"]},
    "stage": {"enum": ["produced", "merged"]},
    "title": {"type": "string"},
    "file": {"type": "string"},
    "line": {"type": "integer", "minimum": 0},

    "target": {"type": "string"},
    "url": {"type": "string"},
    "source": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "run.begin"}}},
     "then": {"required": ["workflow", "mode", "level", "repos", "dir"]}},
    {"if": {"properties": {"type": {"const": "run.end"}}}, "then": {"required": ["workflow", "outcome"]}},
    {"if": {"properties": {"type": {"enum": ["step.begin", "step.end"]}}}, "then": {"required": ["index", "name"]}},
    {"if": {"properties": {"type": {"enum": ["agent.spawn", "agent.return"]}}}, "then": {"required": ["agent"]}},
    {"if": {"properties": {"type": {"const": "model.turn"}}}, "then": {"required": ["model", "tokens"]}},
    {"if": {"properties": {"type": {"const": "tool.call"}}}, "then": {"required": ["tool"]}},
    {"if": {"properties": {"type": {"const": "script.call"}}}, "then": {"required": ["script", "exit"]}},
    {"if": {"properties": {"type": {"const": "guard"}}}, "then": {"required": ["decision", "reason", "command"]}},
    {"if": {"properties": {"type": {"const": "message"}}}, "then": {"required": ["from", "to", "kind"]}},
    {"if": {"properties": {"type": {"const": "checkpoint"}}}, "then": {"required": ["question"]}},
    {"if": {"properties": {"type": {"const": "finding"}}}, "then": {"required": ["severity", "title", "stage"]}},
    {"if": {"properties": {"type": {"const": "loop"}}}, "then": {"required": ["round", "cap"]}},
    {"if": {"properties": {"type": {"const": "github"}}}, "then": {"required": ["action", "target"]}},
    {"if": {"properties": {"type": {"const": "session"}}},
     "then": {"required": ["kind"], "properties": {"kind": {"enum": ["start", "end", "compact"]}}}}
  ]
}
