#!/usr/bin/env bash
# Usage: voice-samples [LIMIT]
# The owner's own recent writing on GitHub, as JSON, to mine their voice: inline review comments, review summaries
# and PR descriptions they wrote (LIMIT PRs of each kind, default 20). Read-only.
set -euo pipefail
for dep in gh jq; do command -v "$dep" >/dev/null || { echo "voice-samples: missing dependency: $dep" >&2; exit 1; }; done
limit="${1:-20}"
[[ "$limit" =~ ^[0-9]+$ ]] || { echo "voice-samples: LIMIT must be a number" >&2; exit 2; }
me="$(gh api user --jq .login)"

reviewed="$(gh search prs --reviewed-by "$me" --limit "$limit" --sort updated --json repository,number,url)"
authored="$(gh search prs --author "$me" --limit "$limit" --sort updated --json repository,number,url,title,body)"

comments="[]"
while IFS=$'\t' read -r repo num url; do
  [ -n "$repo" ] || continue
  c="$(gh api "repos/$repo/pulls/$num/comments" --paginate \
        --jq "[.[] | select(.user.login == \"$me\") | {kind: \"inline\", url: .html_url, body}]" 2>/dev/null || echo '[]')"
  r="$(gh api "repos/$repo/pulls/$num/reviews" --paginate \
        --jq "[.[] | select(.user.login == \"$me\" and (.body // \"\") != \"\") | {kind: \"review\", url: .html_url, body}]" 2>/dev/null || echo '[]')"
  comments="$(jq -s 'add' <(printf '%s' "$comments") <(printf '%s' "$c" | jq -s 'add // []') <(printf '%s' "$r" | jq -s 'add // []'))"
done < <(jq -r '.[] | [.repository.nameWithOwner, (.number|tostring), .url] | @tsv' <<<"$reviewed")

jq -n --arg me "$me" --argjson c "$comments" --argjson a "$authored" '{
  login: $me,
  reviewComments: $c,
  prDescriptions: [$a[] | select((.body // "") != "") | {kind: "pr", url, title, body}]
}'
