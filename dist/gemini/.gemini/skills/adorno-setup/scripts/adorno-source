#!/usr/bin/env bash
# Usage: adorno-source
# Prints {"source": "<adorno repo>", "local": "<personal layer>", "localExists": bool}.
# The adorno repo comes from $ADORNO_SOURCE, else from the record of your global install (~/.adorno/installed.json).
# A record found inside a project is never trusted: a cloned repo could ship one pointing at its own bin/kit.
set -euo pipefail
command -v jq >/dev/null || { echo "adorno-source: missing dependency: jq" >&2; exit 1; }

src="${ADORNO_SOURCE:-}"
record="$HOME/.adorno/installed.json"
if [ -z "$src" ] && [ -f "$record" ]; then src="$(jq -r '.source // empty' "$record")"; fi
if [ -z "$src" ] || [ ! -x "$src/bin/kit" ] || ! grep -q '^name: adorno$' "$src/kit.yaml" 2>/dev/null; then
  echo "adorno-source: adorno repo not found; run bin/kit install --global from it, or set ADORNO_SOURCE" >&2
  exit 3
fi
local_dir="${ADORNO_LOCAL:-$src/local}"
jq -n --arg s "$src" --arg l "$local_dir" --argjson e "$([ -d "$local_dir" ] && echo true || echo false)" \
  '{source: $s, local: $l, localExists: $e}'
