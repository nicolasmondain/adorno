#!/usr/bin/env bash
# Usage: run-end ID
# Ends a run started with run-begin: its grant is withdrawn; its run folder stays, with the deliverables.
. "$(dirname "$0")/_lib.sh"

id="${1:-}"
[[ "$id" =~ ^[0-9T]+-[0-9]+-[0-9]+$ ]] || die "usage: run-end ID (as printed by run-begin)" "$E_USAGE"
f="$(runs_dir)/$id.json"
[ -f "$f" ] || die "no active run $id (already ended or expired)" "$E_USAGE"
jq '{ended: .id, workflow, dir}' "$f"
journal_event run.end "$(jq '{workflow, outcome: "ended"}' "$f")" --run "$id"
# what the hooks do not carry (models, tokens) is read from the session's transcripts, without making run-end wait;
# what goes wrong is said in the journal's enrich.log, and `journal.py enrich ID` runs it again
journal="$(jq -r '.journal // empty' "$f")"
if journal_on && [ -d "$journal" ]; then
  ( python3 "$JOURNAL_PY" enrich "$id" >/dev/null 2>>"$journal/enrich.log" </dev/null & )
fi
rm -f "$f"
