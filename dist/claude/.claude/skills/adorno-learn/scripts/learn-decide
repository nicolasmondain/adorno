#!/usr/bin/env bash
# Usage: learn-decide KEY accepted|rejected|later [NOTE]
# Records the owner's decision on a candidate. `rejected` is final: learn-note keeps the key rejected.
set -euo pipefail
command -v jq >/dev/null 2>&1 || { echo "learn-decide: missing dependency: jq" >&2; exit 1; }
key="${1:-}" decision="${2:-}" note="${3:-}"
case "$decision" in accepted|rejected|later) ;; *) echo "learn-decide: usage: learn-decide KEY accepted|rejected|later [NOTE]" >&2; exit 2 ;; esac
f="$HOME/.adorno/learn/candidates.json"
die() { printf 'learn-decide: %s\n' "$1" >&2; exit "${2:-1}"; }
[ -f "$f" ] && jq -e --arg k "$key" '.[$k] != null' "$f" >/dev/null || die "no candidate '$key'" 3
# serialise read-modify-write: parallel runs must not lose each other's notes
lock="$f.lock"; tries=0
until mkdir "$lock" 2>/dev/null; do
  if [ -n "$(find "$lock" -maxdepth 0 -mmin +5 2>/dev/null)" ]; then rm -rf "$lock"; continue; fi
  tries=$((tries + 1)); [ "$tries" -lt 300 ] || die "timed out waiting for $lock"
  sleep 0.1
done
trap 'rm -rf "$lock" "$f.$$.tmp"' EXIT

jq --arg k "$key" --arg d "$decision" --arg n "$note" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  '.[$k] |= (.status = $d | .decided = $now | if $n == "" then . else .note = $n end)' "$f" >"$f.$$.tmp" && mv "$f.$$.tmp" "$f"
jq --arg k "$key" '.[$k] | {key, status, decided}' "$f"
