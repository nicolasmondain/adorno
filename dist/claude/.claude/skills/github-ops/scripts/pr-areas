#!/usr/bin/env bash
# Usage: pr-areas owner/repo DIFF_FILE
# Classifies a unified diff into code areas (front, back, mongodb, api, …) with the `areas` rules of
# repos.yaml — path globs, plus a regex on added lines — and lists the reviewers to call
# (`area_reviewers`: `always` + one list per touched area). Files matching no area land in `other`.
# Prints JSON {files, areas: {area: [paths]}, other: [paths], reviewers: [agent ids]}.
. "$(dirname "$0")/_lib.sh"

split_repo "${1:-}"
diff="${2:-}"
[ -f "$diff" ] || die "usage: pr-areas owner/repo DIFF_FILE" "$E_USAGE"
conf="$(repo_conf "$REPO")"

tmp="$(work_dir)/areas-$$"; mkdir -p "$tmp"; trap 'rm -rf "$tmp"' EXIT
: >"$tmp/files"; : >"$tmp/added"; : >"$tmp/hits"

# file list from `diff --git a/x b/y` (b/ side, so renames count under their new name), and
# `path<TAB>added line` for every added line
awk -v files="$tmp/files" -v added="$tmp/added" '
  /^diff --git / { i = index($0, " b/"); f = substr($0, i + 3); print f > files; next }
  /^\+\+\+ /     { next }
  /^\+/          { if (f != "") print f "\t" substr($0, 2) > added }
' "$diff"

areas="$(jq -r '.areas // {} | keys[]' <<<"$conf")"
for area in $areas; do
  globs="$(jq -r --arg a "$area" '.areas[$a].paths // [] | .[]' <<<"$conf")"
  if [ -n "$globs" ]; then
    while IFS= read -r f; do
      while IFS= read -r g; do
        # shellcheck disable=SC2053  # $g is a glob on purpose
        if [[ "$f" == $g ]]; then printf '%s\t%s\n' "$area" "$f" >>"$tmp/hits"; break; fi
      done <<<"$globs"
    done <"$tmp/files"
  fi
  regex="$(jq -r --arg a "$area" '.areas[$a].content // empty' <<<"$conf")"
  if [ -n "$regex" ]; then
    AREA_RE="$regex" awk -F'\t' -v area="$area" '
      { line = $0; sub(/^[^\t]*\t/, "", line); if (line ~ ENVIRON["AREA_RE"]) print area "\t" $1 }
    ' "$tmp/added" >>"$tmp/hits"
  fi
done

jq -n --rawfile files "$tmp/files" --rawfile hits "$tmp/hits" --argjson conf "$conf" '
  ($files | split("\n") | map(select(. != ""))) as $all
  | ($hits | split("\n") | map(select(. != "") | split("\t") | {area: .[0], file: .[1]}) | unique) as $h
  | ($h | group_by(.area) | map({key: .[0].area, value: [.[].file]}) | from_entries) as $areas
  | ($conf.area_reviewers // {}) as $map
  | { files: ($all | length),
      areas: $areas,
      other: [$all[] | select(. as $f | $h | map(.file) | index($f) | not)],
      reviewers: ((($map.always // []) + [$areas | keys[] | ($map[.] // [])[]])
                  | reduce .[] as $r ([]; if index($r) then . else . + [$r] end)) }'
