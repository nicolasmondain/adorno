{
  "defaults": {
    "resolve_threads": "author",
    "reply_language": "en",
    "max_level": "L3",
    "ponytail": "full",
    "branch_pattern": "^(feat|fix|perf|refactor|test|docs|style|build|ci|chore|revert)/[a-z0-9]+(-[a-z0-9]+)*$",
    "max_usd": {"workflow:pr:review": 10}
  },
  "repos": {
    "acme/docs": {
      "base": "main",
      "required_checks": [],
      "reviewers": [
        "alice",
        "octocat"
      ],
      "notion_spec": {
        "start": {
          "Lifecycle": "Ongoing",
          "Owner": null
        },
        "pr_opened": {
          "Lifecycle": "In Code Review",
          "PR": "{{pr_url}}"
        }
      },
      "after_pr": [
        {"skill": "/acme-notion-fields", "workflows": ["workflow:issue:fix"], "needs": "notion"},
        {"skill": "acme-changelog", "workflows": ["workflow:issue:fix", "workflow:feature:build"]}
      ]
    },
    "acme/readonly": {
      "max_level": "L0"
    },
    "acme/strict": {
      "resolve_threads": "reviewer",
      "ponytail": "ultra",
      "max_usd": {"workflow:pr:review": 2},
      "required_checks": [
        "build"
      ]
    },
    "acme/docs-*": {
      "vision": [
        "docs glob vision"
      ]
    },
    "acme/docs-public": {
      "permissions": {
        "deny": [
          "reply",
          "submit"
        ]
      },
      "context": [
        "exact line"
      ]
    },
    "other/*": {
      "max_level": "L1"
    }
  },
  "presets": {
    "team-x": {
      "team": {
        "name": "x"
      },
      "context": [
        "preset line"
      ],
      "use": [
        "base"
      ]
    },
    "base": {
      "reviewers": [
        "carol"
      ]
    }
  },
  "workspaces": {
    "acme-all": {
      "repos": [
        "acme/*"
      ],
      "use": [
        "team-x"
      ],
      "context": [
        "workspace line"
      ],
      "notion_spec": {
        "start": {
          "Lifecycle": "Planned",
          "Working date": "{{today}}",
          "Owner": "workspace"
        }
      }
    }
  },
  "prices": {
    "claude-opus-5-5": {
      "input": 4,
      "cache_write_5m": 5,
      "cache_write_1h": 8,
      "cache_read": 0.2,
      "output": 20
    },
    "claude-sonnet-5-5": {
      "input": 2,
      "cache_write_5m": 2.5,
      "cache_write_1h": 4,
      "cache_read": 0.2,
      "output": 10
    },
    "claude-haiku-5-5": {
      "input": 0.1,
      "cache_write_5m": 0.125,
      "cache_write_1h": 0.2,
      "cache_read": 0.01,
      "output": 0.5
    }
  }
}
