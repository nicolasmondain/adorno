#!/usr/bin/env bash
# Usage: run-budget ID
# Read-only: has the active run ID (as printed by run-begin) stayed under its cost cap (max_usd, set at run-begin)?
# The session calls it before each delegation, each loop round and each batch of parallel agents. It measures the run
# since it started the way run-end does (run-usage collect over the run's session, from `started` to now) and writes
# nothing: no usage.json, no status.md, no index line.
# No cap: prints {capped: false, id, workflow, max_usd: null, reason}, exit 0. Else prints {capped: true, id, workflow,
# max_usd, usd, remaining, unpriced, source, stop, reason} and exits 7 (E_BUDGET) when the run must stop (stop: true):
# usd >= max_usd; a model with no price (unpriced non-empty: the cap cannot be guaranteed, price it in
# local/adorno.yaml › prices); or the cost cannot be measured (source unavailable or error: no Claude Code session or
# transcript; `--max-usd off` at run-begin is the explicit way to run uncapped). Unknown or expired ID: exit 2.
# Calls made through adorno-llm (an external endpoint, no transcript) are not counted.
. "$(dirname "$0")/_lib.sh"

id="${1:-}"
[ $# -eq 1 ] && [[ "$id" =~ ^[0-9T]+-[0-9]+-[0-9]+$ ]] || die "usage: run-budget ID (ID as printed by run-begin)" "$E_USAGE"
run="$(active_runs | jq -c --arg id "$id" 'map(select(.id == $id)) | first // empty')"
[ -n "$run" ] || die "no active run $id (already ended or expired)" "$E_USAGE"
if jq -e '(.max_usd | type) != "number"' <<<"$run" >/dev/null; then
  jq '{capped: false, id, workflow, max_usd: null, reason: "no cost cap for this run"}' <<<"$run"
  exit 0
fi

now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
err="$(work_dir)/run-budget-err"
# as run-end: ADORNO_JOURNAL=0, so this check is one script.call in the journal, not two
if ! usage="$(ADORNO_JOURNAL=0 "$(dirname "$0")/run-usage" collect --session "$(jq -r '.session // ""' <<<"$run")" \
       --since "$(jq -r '.started' <<<"$run")" --until "$now" 2>"$err")"; then
  usage="$(jq -n --arg e "$(head -c 300 "$err")" '{source: "error", reason: "run-usage failed: \($e)"}')"
fi
out="$(jq --argjson run "$run" '
  def money: "$\(. * 100 | round / 100)";
  (.totals.usd // null) as $usd | (.unpriced // []) as $unpriced | $run.max_usd as $max
  | (.source != "claude-code" or ($unpriced | length) > 0 or $usd >= $max) as $stop
  | (if .source != "claude-code" then
       "cost cannot be measured (\(.reason // .source)): stop here;"
       + " `--max-usd off` at run-begin is the explicit way to run uncapped"
     elif ($unpriced | length) > 0 then
       "no price for \($unpriced | join(", ")): the cap cannot be guaranteed;"
       + " add their price in local/adorno.yaml › prices, then bin/kit install"
     elif $usd >= $max then "over the cap: \($usd | money) spent of \($max | money)"
     else "under the cap: \($usd | money) spent of \($max | money)" end) as $reason
  | {capped: true, id: $run.id, workflow: $run.workflow, max_usd: $max, usd: $usd,
     remaining: (if $usd == null then null else $max - $usd end), unpriced: $unpriced, source, stop: $stop,
     reason: $reason}' \
  <<<"$usage")"
printf '%s\n' "$out"
if jq -e .stop <<<"$out" >/dev/null; then
  log "run $id must stop: $(jq -r .reason <<<"$out")"
  exit "$E_BUDGET"
fi
