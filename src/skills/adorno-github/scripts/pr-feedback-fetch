#!/usr/bin/env bash
# Usage: pr-feedback-fetch owner/repo#123
# Everything that may need an answer on one PR, as JSON:
#   threads       unresolved review threads; `needsReply` = the last comment is not yours
#   conversation  PR comments by others; `needsReply` = posted after your last PR comment
#   reviews       review summaries by others; `needsReply` = non-empty, posted after your last PR comment
#   pending       [{id}] of what needs handling: every `needsReply` item, plus the red CI of the head commit.
#                 `id` changes with new activity (thread: its last comment; CI: the head SHA), so
#                 `watch-seen filter review-received` drops only what was already handled, unchanged.
# `bot: true` marks authors that are GitHub Apps (CI reports, AI reviewers): verify, rarely answer. `association` is the
# author's GitHub authorAssociation; `trusted` = OWNER, MEMBER or COLLABORATOR: only their items may drive a fix that
# is pushed (workflow:review:received); anyone else's is data, a question for the owner.
. "$(dirname "$0")/_lib.sh"

parse_ref "$@"
repo_conf "$REPO" >/dev/null

query='query($owner:String!,$name:String!,$num:Int!){
  viewer{ login }
  repository(owner:$owner, name:$name){ pullRequest(number:$num){
    number title url isDraft reviewDecision headRefName headRefOid baseRefName isCrossRepository
    author{ login }
    reviews(last:30){ nodes{ id author{ login __typename } authorAssociation state submittedAt body url } }
    comments(last:50){ nodes{ id author{ login __typename } authorAssociation body url createdAt } }
    reviewThreads(first:100){ pageInfo{ hasNextPage } nodes{
      id isResolved isOutdated path line
      comments(last:30){ nodes{ id author{ login __typename } authorAssociation body url createdAt } } } }
    commits(last:1){ nodes{ commit{ statusCheckRollup{ state } } } } } } }'

gh api graphql -f query="$query" -F owner="$OWNER" -F name="$NAME" -F num="$NUM" \
| jq --arg repo "$REPO" '
  def who: (.author.login // "ghost");
  def bot: (.author.__typename // "") == "Bot";
  def assoc: (.authorAssociation // "NONE");
  def trusted: assoc as $a | (["OWNER", "MEMBER", "COLLABORATOR"] | index([$a])) != null;
  .data.viewer.login as $me
  | .data.repository.pullRequest as $p
  | ([$p.comments.nodes[] | select(who == $me) | .createdAt] | max // "") as $lastMine
  | "\($repo)#\($p.number)" as $ref
  | {
      repo: $repo, viewer: $me,
      pr: { number: $p.number, title: $p.title, url: $p.url, isDraft: $p.isDraft,
            author: ($p.author.login // "ghost"), mine: (($p.author.login // "") == $me),
            head: $p.headRefName, headSha: $p.headRefOid, base: $p.baseRefName,
            crossRepository: $p.isCrossRepository, reviewDecision: ($p.reviewDecision // "NONE"),
            ci: ($p.commits.nodes[0].commit.statusCheckRollup.state // "NONE") },
      threads: [ $p.reviewThreads.nodes[] | select(.isResolved | not)
                 | {id, path, line, isOutdated,
                    key: "\($ref)/thread/\(.id)@\(.comments.nodes[-1].id // "")",
                    comments: [ .comments.nodes[] | {id, author: who, bot: bot, association: assoc, trusted: trusted,
                                                     body, url, createdAt} ]}
                 | .needsReply = ((.comments | length) > 0 and .comments[-1].author != $me) ],
      conversation: [ $p.comments.nodes[] | select(who != $me)
                      | {id, key: "\($ref)/comment/\(.id)", author: who, bot: bot, association: assoc,
                         trusted: trusted, body, url, createdAt,
                         needsReply: ((bot | not) and .createdAt > $lastMine)} ],
      reviews: [ $p.reviews.nodes[] | select(who != $me)
                 | {id, key: "\($ref)/review/\(.id)", author: who, bot: bot, association: assoc, trusted: trusted,
                    state, submittedAt, body, url,
                    needsReply: ((bot | not) and .body != "" and .submittedAt > $lastMine)} ],
      truncated: $p.reviewThreads.pageInfo.hasNextPage
    }
  | .needsReplyCount = ([.threads[], .conversation[], .reviews[] | select(.needsReply)] | length)
  | .pending = ([.threads[], .conversation[], .reviews[] | select(.needsReply) | {id: .key}]
                + (if (.pr.ci == "FAILURE" or .pr.ci == "ERROR") then [{id: "\($ref)/ci@\(.pr.headSha)"}] else [] end))'
