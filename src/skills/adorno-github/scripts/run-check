#!/usr/bin/env bash
# Usage: run-check owner/repo|--dir PATH LEVEL [action]
# Read-only: would a write at LEVEL (and ACTION) be allowed on this repo right now? Same rules as every write script
# (require_level: the repo's max_level and permissions.deny, the active run of this session, its denied actions),
# plus: a dry-run run allows nothing. With --dir, the repo is the GitHub origin of the git repository at PATH.
# Used by guard_bash.py to let a repo's own commit or PR skill run `gh pr create|edit` without a prompt inside a run.
# Prints {allowed, repo, level, action}; exit 0 if allowed, else the code of the refusal (4 policy, 5 level).
. "$(dirname "$0")/_lib.sh"

if [ "${1:-}" = "--dir" ]; then
  [ -d "${2:-}" ] || die "no such directory: ${2:-}" "$E_USAGE"
  split_repo "$(cd "$2" && current_repo)"; shift 2
else
  split_repo "${1:-}"; shift || true
fi
level="${1:-}"; action="${2:-}"
case "$level" in L0|L1|L2|L3) ;; *) die "LEVEL: L0..L3" "$E_USAGE" ;; esac
require_level "$REPO" "$level" "$action"
! dry_run || die "the active run is a dry run: nothing leaves the machine" "$E_POLICY"
jq -n --arg r "$REPO" --arg l "$level" --arg a "$action" '{allowed: true, repo: $r, level: $l, action: $a}'
