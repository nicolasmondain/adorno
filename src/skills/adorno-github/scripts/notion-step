#!/usr/bin/env bash
# Usage: notion-step plan STEP RUN_DIR [owner/repo] [--pr-url URL] [--force]
#        notion-step done STEP RUN_DIR
# The Notion page used as the spec of a run gets the properties your repo config sets for each workflow step
# (`notion_spec.start`, `notion_spec.pr_opened` in local/adorno.yaml). This script only decides; the agent writes
# through the Notion connector (skill adorno-notion-sync), then records it with `done`.
#   plan → {step, page_id, url, properties, dry_run}: the page is the first Notion link of the request
#          (RUN_DIR/refs.json, written by adorno-inputs), `{{today}}` and `{{pr_url}}` replaced, null values dropped.
#          Or {step, skip: reason} when the repo sets nothing for STEP, the request has no Notion page, or STEP is
#          already done for this run (RUN_DIR/notion.json; --force plans it again).
#   done → appends what `plan` returned ({step, page_id, at, properties}) to RUN_DIR/notion.json, once the connector
#          has written it.
# No level check: the repo config is the opt-in. A report or draft run makes dry_run true: nothing is written.
. "$(dirname "$0")/_lib.sh"

STEPS="start pr_opened"
usage="usage: notion-step plan STEP RUN_DIR [owner/repo] [--pr-url URL] [--force] | done STEP RUN_DIR"
cmd="${1:-}" step="${2:-}" dir="${3:-}"
case "$cmd" in plan|done) ;; *) die "$usage" "$E_USAGE" ;; esac
case " $STEPS " in *" $step "*) ;; *) die "unknown step '$step' (steps: $STEPS)" "$E_USAGE" ;; esac
[ -n "$dir" ] && [ -d "$dir" ] || die "run folder not found: '${dir}'" "$E_USAGE"
shift 3

repo="" pr_url="" force=false
while [ $# -gt 0 ]; do
  case "$1" in
    --pr-url) pr_url="${2:-}"; shift 2 ;;
    --force) force=true; shift ;;
    -*) die "unknown option $1" "$E_USAGE" ;;
    *) [ -z "$repo" ] || die "$usage" "$E_USAGE"; repo="$1"; shift ;;
  esac
done

refs="$dir/refs.json" log_file="$dir/notion.json"
page="$( [ -f "$refs" ] && jq -c '[.refs[]? | select(.kind == "notion")] | first // empty' "$refs" || true)"
done_entry() { [ -f "$log_file" ] && jq -e --arg s "$step" 'any(.[]; .step == $s)' "$log_file" >/dev/null; }
skip() { jq -n --arg s "$step" --arg r "$1" '{step: $s, skip: $r}'; exit 0; }

if [ "$cmd" = "done" ]; then
  planned="$dir/.notion-$step.json"
  [ -f "$planned" ] || die "nothing planned for $step in $dir: run notion-step plan first" "$E_USAGE"
  [ -f "$log_file" ] || echo '[]' >"$log_file"
  jq --arg s "$step" --slurpfile p "$planned" \
    '. + [{step: $s, page_id: $p[0].page_id, at: (now | todate), properties: $p[0].properties}]' "$log_file" >"$log_file.tmp"
  mv "$log_file.tmp" "$log_file"
  rm -f "$planned"
  jq --arg s "$step" 'map(select(.step == $s)) | last' "$log_file"
  exit 0
fi

split_repo "${repo:-$(current_repo)}"
props="$(repo_conf "$REPO" | jq -c --arg s "$step" '.notion_spec[$s] // empty | with_entries(select(.value != null))')"
[ -n "$props" ] && [ "$props" != "{}" ] || skip "$REPO sets no notion_spec.$step"
[ -n "$page" ] || skip "the request has no Notion page ($refs)"
if ! $force && done_entry; then skip "already done for this run ($log_file; --force to redo)"; fi
if jq -e 'any(.[]; type == "string" and contains("{{pr_url}}"))' >/dev/null <<<"$props" && [ -z "$pr_url" ]; then
  die "notion_spec.$step uses {{pr_url}}: pass --pr-url" "$E_USAGE"
fi

dry=false; dry_run && dry=true
jq -n --arg s "$step" --argjson p "$page" --argjson props "$props" --arg today "$(date +%Y-%m-%d)" \
  --arg pr "$pr_url" --argjson dry "$dry" '
  {step: $s, page_id: $p.page_id, url: $p.url, dry_run: $dry,
   properties: ($props | map_values(if type == "string"
     then gsub("\\{\\{today\\}\\}"; $today) | gsub("\\{\\{pr_url\\}\\}"; $pr) else . end))}' | tee "$dir/.notion-$step.json"
