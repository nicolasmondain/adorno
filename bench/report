#!/usr/bin/env python3
"""Usage: report --label NAME [--against NAME] [--save-baseline NAME] [--results DIR] [--cases DIR]
              [--baselines DIR]

The report of a benchmark run, at no model cost: scores RESULTS/<label>/ again (bench/score), prints a Markdown
report and writes it next to the results as report.md, with report.json ({score, comparison}).

--against NAME compares with another run (RESULTS/NAME/) or, failing that, with a baseline (BASELINES/NAME.json):
what improved, what regressed and by how many points, overall and per case; per reviewer, on the case runs both
have (a reference scored before the per case run detail gets no per reviewer comparison). The cases of kind analyst
are reported, not compared.
--save-baseline NAME writes the scores of the run to BASELINES/NAME.json (bench/baselines by default), without any
model text: the owner runs it on a run they validate as a reference, and commits the file. It never overwrites.
Exits 2 on wrong usage.
"""
import argparse
import importlib.util
import json
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True  # bench/score is loaded as a module: no cache next to it
_LOADER = SourceFileLoader("bench_score", str(ROOT / "bench" / "score"))
SCORE = importlib.util.module_from_spec(importlib.util.spec_from_loader(_LOADER.name, _LOADER))
_LOADER.exec_module(SCORE)
ICON = {"blocker": "🔴", "major": "🟠", "minor": "🟡", "question": "❓"}


def die(message, code=1):
    print(f"report: {message}", file=sys.stderr)
    sys.exit(code)


# ── wording ───────────────────────────────────────────────────────────────────────────────────────────────────────
def pct(value):
    return "–" if value is None else f"{value * 100:.0f}%"


def spread(value):
    if value is None:
        return "–"
    if value["min"] == value["max"]:
        return pct(value["mean"])
    return f"{pct(value['mean'])} (worst {pct(value['min'])}, best {pct(value['max'])})"


def money(value):
    return "–" if value is None else f"${value:.2f}"


def tokens(count):
    if count >= 1_000_000:
        return f"{count / 1_000_000:.1f}M"
    return f"{count / 1000:.0f}k" if count >= 1000 else str(count)


def minutes(ms):
    return f"{ms / 60000:.1f} min"


def points(value):
    if value is None:
        return "–"
    return "=" if value == 0 else f"{value:+d} pts"


def table(header, rows):
    lines = ["| " + " | ".join(header) + " |", "| " + " | ".join("---" for _ in header) + " |"]
    return lines + ["| " + " | ".join(str(cell) for cell in row) + " |" for row in rows]


# ── comparison ────────────────────────────────────────────────────────────────────────────────────────────────────
def mean(value):
    return None if value is None else value["mean"]


def rate(part, whole):
    return part / whole if whole else None


def delta(new, old):
    return None if new is None or old is None else round((new - old) * 100)


def deltas(new, old):
    """Points gained (+) or lost (-) between two summaries."""
    return {"recall": delta(mean(new["recall"]), mean(old["recall"])),
            "precision": delta(mean(new["precision"]), mean(old["precision"])),
            "verdict": delta(rate(new["verdict_ok"], new["runs"]), rate(old["verdict_ok"], old["runs"])),
            "severity": delta(rate(new["severity_ok"], new["found"]), rate(old["severity_ok"], old["found"])),
            "dropped": delta(mean(new.get("dropped")), mean(old.get("dropped")))}  # cases of kind adorno only


def status(change):
    moved = [value for value in change.values() if value]
    if not moved:
        return "same"
    if all(value > 0 for value in moved):
        return "improved"
    return "regressed" if all(value < 0 for value in moved) else "mixed"


def per_run(summary):
    return None if summary["cost_usd"] is None or not summary["runs"] else summary["cost_usd"] / summary["runs"]


def per_call(score, agent):
    a = score["agents"].get(agent) or {}
    return None if a.get("cost_usd") is None or not a.get("calls") else a["cost_usd"] / a["calls"]


def case_runs(score):
    """The runs of the review cases: a case of kind adorno or analyst runs no reviewer."""
    return {(case_id, r["n"]) for case_id, case in score["cases"].items() if case.get("kind", "review") == "review"
            for r in case["runs"]}


def compare_reviewers(new, old, shared):
    """Per reviewer, on the SHARED case runs: points of own recall and precision, false alarms, rejected reviews and
    the cost of one call, in %. None when a run has no per case run detail (scored before it)."""
    if any("runs" not in r for score in (new, old) for r in score.get("reviewers", {}).values()):
        return None
    found = {}
    for agent in sorted(set(new.get("reviewers", {})) & set(old.get("reviewers", {}))):
        a, b = ([e for e in score["reviewers"][agent]["runs"] if (e["case"], e["n"]) in shared] for score in (new, old))
        if not a or not b:
            continue
        a, b = SCORE.summarize_agent(a), SCORE.summarize_agent(b)
        cost_a, cost_b = (rate(r["cost_usd"], r["calls"]) if r["cost_usd"] is not None else None for r in (a, b))
        found[agent] = {"own_recall": delta(mean(a["own_recall"]), mean(b["own_recall"])),
                        "precision": delta(mean(a["precision"]), mean(b["precision"])),
                        "false_alarms": a["false_alarms"] - b["false_alarms"],
                        "invalid_reviews": a["invalid_reviews"] - b["invalid_reviews"],
                        "cost_pct": None if cost_a is None or not cost_b else round((cost_a / cost_b - 1) * 100)}
    return found


def compare(new, old):
    shared = sorted(case_id for case_id in set(new["cases"]) & set(old["cases"])
                    if new["cases"][case_id].get("kind") != "analyst")  # shortcut: analyst runs are not compared
    runs = case_runs(new) & case_runs(old)
    cases = []
    for case_id in shared:
        a, b = new["cases"][case_id]["summary"], old["cases"][case_id]["summary"]
        change = deltas(a, b)
        cost = None if per_run(a) is None or per_run(b) is None else round(per_run(a) - per_run(b), 4)
        cases.append(dict(change, case=case_id, status=status(change), cost_usd=cost))
    overall = deltas(new["overall"], old["overall"])
    a, b = per_run(new["overall"]), per_run(old["overall"])
    adorno = deltas(new["adorno"], old["adorno"]) if new.get("adorno") and old.get("adorno") else None
    return {"against": old["label"], "overall": dict(overall, status=status(overall),
                                                     cost_usd=None if a is None or b is None else round(a - b, 4)),
            "adorno": adorno and dict(adorno, status=status(adorno)),
            "cases": cases, "reviewers": compare_reviewers(new, old, runs), "shared_runs": len(runs),
            "only_here": sorted(set(new["cases"]) - set(old["cases"])),
            "only_there": sorted(set(old["cases"]) - set(new["cases"]))}


def adorno_section(score, comparison):
    """Cases of kind adorno: agent:adorno alone, on the fixed review the case brings."""
    a = score["adorno"]
    rows = [["kept", spread(a["recall"]), f"{a['found']}/{a['expected']} true findings kept"],
            ["dropped", spread(a["dropped"]),
             f"{a['planted'] - a['planted_kept']}/{a['planted']} planted false findings left out"],
            ["precision", spread(a["precision"]), f"{a['comments']} inline comments, {a['ungraded']} to grade"],
            ["severity", f"{a['severity_ok']}/{a['found']}", "kept findings at an accepted severity"],
            ["verdict", f"{a['verdict_ok']}/{a['runs']}",
             f"{a['none']} with nothing to post, {a['absent']} absent, {a['invalid']} invalid"],
            ["cost", money(a["cost_usd"]), f"{tokens(a['tokens_in'])} tokens in, {tokens(a['tokens_out'])} out"]]
    change = comparison and comparison.get("adorno")
    if change:
        versus = {"kept": points(change["recall"]), "dropped": points(change["dropped"]),
                  "precision": points(change["precision"]), "severity": points(change["severity"]),
                  "verdict": points(change["verdict"])}
        rows = [row + [versus.get(row[0], "")] for row in rows]
    header = ["Measure", "Value", "Detail"] + ([f"vs {comparison['against']}"] if change else [])
    lines = ["## agent:adorno on a fixed review", "",
             "The case brings the specialists' reviews, true and planted false findings: agent:adorno alone runs.", ""]
    lines += table(header, rows) + [""]
    rows = []
    for case_id, case in sorted(score["cases"].items()):
        if case.get("kind") != "adorno":
            continue
        s = case["summary"]
        verdicts = ", ".join(sorted({r["final"]["verdict"] or "–" for r in case["runs"]}))
        rows.append([f"`{case_id}`", spread(s["recall"]), spread(s["dropped"]), spread(s["precision"]),
                     f"{s['verdict_ok']}/{s['runs']} ({verdicts})", s["ungraded"], money(s["cost_usd"])])
    return lines + table(["Case", "Kept", "Dropped", "Precision", "Verdict", "To grade", "Cost"], rows) + [""]


def analyst_section(score):
    """Cases of kind analyst: agent:core:analyst alone, on a Slack thread or a Notion document."""
    a = score["analyst"]
    rows = [["causes", f"{a['causes_found']}/{a['causes_expected']}",
             "expected causes cited at their file:line under Probable causes"],
            ["flagged", f"{a['flagged']}/{a['flags_expected']}",
             "planted instructions named under Instructions found in the source"],
            ["followed", a["followed"], "case runs whose Proposed next step takes up a forbidden action"],
            ["canary", a["canary"], "case runs that left in the workspace the file a planted instruction asks for"],
            ["clean", f"{a['clean_ok']}/{a['clean']}",
             "clean case runs whose Instructions found in the source is None"],
            ["delivered", f"{a['delivered']}/{a['runs']}", "case runs that wrote analysis.md"],
            ["cost", money(a["cost_usd"]), f"{tokens(a['tokens_in'])} tokens in, {tokens(a['tokens_out'])} out"]]
    lines = ["## agent:core:analyst on a Slack thread or a Notion page", "",
             "The case brings a Slack thread or a Notion document and the repo it concerns, with no change: "
             "agent:core:analyst alone runs, and flags the planted instructions without following them.", ""]
    lines += table(["Measure", "Value", "Detail"], rows) + [""]
    rows = []
    for case_id, case in sorted(score["cases"].items()):
        if case.get("kind") != "analyst":
            continue
        s = case["summary"]
        rows.append([f"`{case_id}`", f"{s['causes_found']}/{s['causes_expected']}",
                     f"{s['flagged']}/{s['flags_expected']}" if s["flags_expected"] else "–", s["followed"],
                     s["canary"], f"{s['clean_ok']}/{s['clean']}" if s["clean"] else "–",
                     f"{s['delivered']}/{s['runs']}", money(s["cost_usd"])])
    return lines + table(["Case", "Causes", "Flagged", "Followed", "Canary", "Clean", "Delivered", "Cost"], rows) + [""]


# ── the report ────────────────────────────────────────────────────────────────────────────────────────────────────
def render(score, comparison):
    run, overall = score["run"], score["overall"]
    prompts = run["prompts"]
    sha = (prompts["sha"] or "unknown")[:7] + (" + uncommitted changes" if prompts["dirty"] else "")
    lines = [f"# Reviewer benchmark: {score['label']}", "",
             f"{run['tool']} ({run['tool_version']}), model: {run['model'] or 'the tier of each agent'}"
             + "".join(f", {agent} on {model}" for agent, model in sorted(run.get("agent_models", {}).items()))
             + ", prompts "
             f"{sha}, {len(score['cases'])} cases, {run['repeat']} repeat(s), routing of `{run['repo']}`, "
             f"started {run['started_at']}.", ""]
    if run["skipped"]:
        skipped = ", ".join(f"{s['case']} #{s['n']}" for s in run["skipped"])
        lines += [f"> **Incomplete run**: the budget of {money(run['budget_usd'])} stopped it before {skipped}.", ""]
    if run["failed"]:
        failed = ", ".join(f"{f['case']} #{f['n']}" for f in run["failed"])
        lines += [f"> **Failed case runs**, not scored: {failed}. An agent left links in its run folder (named in "
                  "their run.json).", ""]
    final, clean = overall["final"], overall["clean"]
    rows = [
        ["recall", spread(overall["recall"]), f"{overall['found']}/{overall['expected']} expected findings found"],
        ["precision", spread(overall["precision"]),
         f"{overall['ungraded']} to grade, {overall['invalid_extras']} false positives, "
         f"{overall['valid_extras']} valid extras, {overall['duplicates']} duplicates"],
        ["severity", f"{overall['severity_ok']}/{overall['found']}", "found findings at an accepted severity"],
        ["attribution", f"{overall['attribution_ok']}/{overall['found']}", "found by the expected reviewer"],
        ["verdict", f"{overall['verdict_ok']}/{overall['runs']}", "merged verdict accepted by the case"],
        ["clean cases", f"{clean['false_alarms']} false alarms",
         f"{clean['verdict_ok']}/{clean['runs']} with the verdict pass"],
        ["routing", f"{overall['routing_ok']}/{overall['runs']}", "areas and reviewers as case.json says"],
        ["reviews", f"{overall['invalid_reviews']} invalid or missing", ""],
        ["after agent:adorno", f"recall {spread(final['recall'])}, precision {spread(final['precision'])}",
         f"{final['comments']} inline comments, verdict {final['verdict_ok']}/{final['runs']}, "
         f"{final['none']} with nothing to post, {final['absent']} absent, {final['invalid']} invalid"],
        ["cost", money(overall["cost_usd"]),
         f"{tokens(overall['tokens_in'])} tokens in, {tokens(overall['tokens_out'])} out, "
         f"{minutes(overall['duration_ms'])} of agent time"]]
    if comparison:
        change = comparison["overall"]
        versus = {"recall": points(change["recall"]), "precision": points(change["precision"]),
                  "severity": points(change["severity"]), "verdict": points(change["verdict"]),
                  "cost": "–" if change["cost_usd"] is None else f"{change['cost_usd']:+.2f} $ per case run"}
        rows = [row + [versus.get(row[0], "")] for row in rows]
    header = ["Measure", "Value", "Detail"] + ([f"vs {comparison['against']}"] if comparison else [])
    lines += ["## Overall", ""] + table(header, rows) + [""]

    rows = []
    reviews = {case_id: case for case_id, case in score["cases"].items() if case.get("kind", "review") == "review"}
    for case_id, case in sorted(reviews.items()):
        s = case["summary"]
        verdicts = ", ".join(sorted({r["verdict"] for r in case["runs"]}))
        rows.append([f"`{case_id}`", spread(s["recall"]), spread(s["precision"]), f"{s['severity_ok']}/{s['found']}",
                     f"{s['verdict_ok']}/{s['runs']} ({verdicts})", s["ungraded"],
                     spread(s["final"]["recall"]), money(s["cost_usd"])])
    lines += ["## Per case", ""] + table(["Case", "Recall", "Precision", "Severity", "Verdict", "To grade",
                                         "Recall after adorno", "Cost"], rows) + [""]

    versus = (comparison or {}).get("reviewers") or {}
    rows = []
    for agent, r in score.get("reviewers", {}).items():
        own = "–" if not r["own_expected"] else f"{spread(r['own_recall'])} ({r['own_found']}/{r['own_expected']})"
        row = [f"`{agent}`", r["reviews"], own, spread(r["precision"]),
               "–" if not r["own_found"] else f"{r['own_severity_ok']}/{r['own_found']}",
               f"{r['false_alarms']} on {r['clean_reviews']}", r["invalid_reviews"],
               money(per_call(score, agent)), ", ".join((score["agents"].get(agent) or {}).get("models", [])) or "–"]
        if comparison:
            v = versus.get(agent)
            row.append("–" if v is None else
                       f"recall {points(v['own_recall'])}, precision {points(v['precision'])}, alarms "
                       f"{v['false_alarms']:+d}, invalid {v['invalid_reviews']:+d}, cost "
                       + ("–" if v["cost_pct"] is None else f"{v['cost_pct']:+d}%"))
        rows.append(row)
    if rows:
        header = ["Reviewer", "Reviews", "Own recall", "Precision", "Own severity", "False alarms (clean)",
                  "Invalid", "Cost per call", "Models"] + ([f"vs {comparison['against']}"] if comparison else [])
        lines += ["## Per reviewer", "",
                  "Each reviewer on its own review, before the merge: own recall counts the expected findings the "
                  "case gives to it.", ""]
        if comparison and comparison["reviewers"] is None:
            lines += [f"{comparison['against']} has no detail per case run (scored before it): no comparison per "
                      "reviewer.", ""]
        elif comparison:
            lines += [f"Against {comparison['against']}: on the {comparison['shared_runs']} case runs both have.", ""]
        lines += table(header, rows) + [""]

    if score.get("adorno"):
        lines += adorno_section(score, comparison)
    if score.get("analyst"):
        lines += analyst_section(score)

    rows = [[f"`{agent}`", a["runs"], a["calls"], ", ".join(a["models"]) or "–", tokens(a["tokens_in"]),
             tokens(a["tokens_out"]), money(a["cost_usd"]), minutes(a["duration_ms"]),
             f"{a['delivered']['salvaged']} salvaged, {a['delivered']['none']} missing"]
            for agent, a in sorted(score["agents"].items())]
    lines += ["## Per agent", ""] + table(["Agent", "Runs", "Calls", "Models", "Tokens in", "Tokens out", "Cost",
                                          "Time", "Review not delivered"], rows) + [""]

    if comparison:
        lines += [f"## Against {comparison['against']}", ""]
        for kind in ("regressed", "mixed", "improved"):
            for c in (c for c in comparison["cases"] if c["status"] == kind):
                dropped = "" if c["dropped"] is None else f", dropped {points(c['dropped'])}"
                lines.append(f"- **{kind}** `{c['case']}`: recall {points(c['recall'])}, precision "
                             f"{points(c['precision'])}, severity {points(c['severity'])}, verdict "
                             f"{points(c['verdict'])}{dropped}")
        same = [c["case"] for c in comparison["cases"] if c["status"] == "same"]
        if same:
            lines.append(f"- same: {', '.join(f'`{c}`' for c in same)}")
        for key, text in (("only_here", "only in this run"), ("only_there", f"only in {comparison['against']}")):
            if comparison[key]:
                lines.append(f"- {text}: {', '.join(f'`{c}`' for c in comparison[key])}")
        lines.append("")

    if score["ungraded"]:
        lines += ["## Findings to grade", "",
                  "Reported, matched by nothing the case plans. Add each to the case's `case.json` › `extras` "
                  "(`file`, `lines`, `keywords`, `valid`: true for a real point, false for a false positive), then "
                  "run the report again.", ""]
        for f in score["ungraded"]:
            who = ", ".join(a.split(":")[-1] for a in f["agents"])
            lines.append(f"- `{f['case']}` #{f['n']} {ICON.get(f['severity'], '')} `{f['file']}:{f['line']}` "
                         f"{f['title']} ({who})")
        lines.append("")
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(prog="report", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--label", required=True)
    parser.add_argument("--against")
    parser.add_argument("--save-baseline")
    parser.add_argument("--results", type=Path, default=ROOT / "bench" / "results")
    parser.add_argument("--cases", type=Path, default=ROOT / "bench" / "cases")
    parser.add_argument("--baselines", type=Path, default=ROOT / "bench" / "baselines")
    args = parser.parse_args()

    def score_of(label):
        done = subprocess.run([sys.executable, str(ROOT / "bench" / "score"), "--label", label, "--results",
                               str(args.results), "--cases", str(args.cases)], capture_output=True, text=True)
        if done.returncode != 0:
            sys.stderr.write(done.stderr)
            sys.exit(done.returncode)
        return json.loads(done.stdout)

    score = score_of(args.label)
    comparison = None
    if args.against:
        if (args.results / args.against / "run.json").is_file():
            reference = score_of(args.against)
        elif (args.baselines / f"{args.against}.json").is_file():
            reference = json.loads((args.baselines / f"{args.against}.json").read_text())
        else:
            die(f"no run and no baseline named {args.against}", 2)
        comparison = compare(score, reference)
    if args.save_baseline:
        target = args.baselines / f"{args.save_baseline}.json"
        if target.exists():
            die(f"{target} already exists: a baseline is never overwritten", 2)
        baseline = json.loads(json.dumps(score))  # the scores only: no title, no message of a model
        del baseline["ungraded"]
        for case in baseline["cases"].values():
            for run in case["runs"]:  # a case run of kind analyst keeps no model text
                run.pop("findings", None)
                run.get("final", {}).pop("findings", None)
        baseline["label"] = args.save_baseline
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(json.dumps(baseline, indent=2, ensure_ascii=False) + "\n")
        print(f"report: baseline written to {target}", file=sys.stderr)

    text = render(score, comparison)
    top = args.results / args.label
    (top / "report.md").write_text(text + "\n")
    (top / "report.json").write_text(json.dumps({"score": score, "comparison": comparison}, indent=2,
                                                ensure_ascii=False) + "\n")
    print(text)


if __name__ == "__main__":
    main()
