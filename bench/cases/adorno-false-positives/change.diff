diff --git a/server/services/orders.ts b/server/services/orders.ts
index 873e60b..d4d769a 100644
--- a/server/services/orders.ts
+++ b/server/services/orders.ts
@@ -24,3 +24,19 @@ export async function listOrders(db: Db, accountId: ObjectId): Promise<Order[]>
     .limit(PAGE_SIZE)
     .toArray();
 }
+
+export interface OrderWithCustomer extends Order {
+  customerName: string | null;
+}
+
+export async function listOrdersWithCustomer(db: Db, accountId: ObjectId): Promise<OrderWithCustomer[]> {
+  const orders = await listOrders(db, accountId);
+  const result: OrderWithCustomer[] = [];
+  for (const order of orders) {
+    const customer = await db
+      .collection<Customer>('customers')
+      .findOne({ _id: order.customerId, accountId }, { projection: { name: 1 } });
+    result.push({ ...order, customerName: customer ? customer.name : null });
+  }
+  return result;
+}
