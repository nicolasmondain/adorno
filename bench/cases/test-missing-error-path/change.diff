@@ -5,3 +5,12 @@ export function applyDiscount(totalCents: number, percent: number): number {
   }
   return Math.round((totalCents * (100 - percent)) / 100);
 }
+
+// Refunds `amountCents` on an order paid `paidCents`, of which `refundedCents` were already refunded.
+// Returns what can still be refunded afterwards.
+export function refund(paidCents: number, refundedCents: number, amountCents: number): number {
+  if (amountCents <= 0 || refundedCents + amountCents > paidCents) {
+    throw new RangeError(`refund out of range: ${amountCents}`);
+  }
+  return paidCents - refundedCents - amountCents;
+}
