+
+const RECENT_REPLIES_LIMIT = 500;
+
+// Ops dashboard: the latest replies across every account.
+export async function listRecentReplies(db: Db, since: Date): Promise<TrackedEvent[]> {
+  return db
+    .collection<TrackedEvent>('events')
+    .find({ type: 'replied', createdAt: { $gte: since } })
+    .sort({ createdAt: -1 })
+    .limit(RECENT_REPLIES_LIMIT)
+    .toArray();
+}
