@@ -5,3 +5,13 @@ export function applyDiscount(totalCents: number, percent: number): number {
   }
   return Math.round((totalCents * (100 - percent)) / 100);
 }
+
+const VAT_RATES: Record<string, number> = { FR: 20, DE: 19, ES: 21 };
+
+export function addVat(totalCents: number, country: string): number {
+  const rate = VAT_RATES[country];
+  if (rate === undefined) {
+    throw new RangeError(`unsupported country: ${country}`);
+  }
+  return Math.round((totalCents * (100 + rate)) / 100);
+}
