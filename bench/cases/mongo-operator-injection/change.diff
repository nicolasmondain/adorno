diff --git a/server/routes/account.ts b/server/routes/account.ts
index 1125be7..2aeaf27 100644
--- a/server/routes/account.ts
+++ b/server/routes/account.ts
@@ -15,5 +15,17 @@ export function accountRouter(db: Db): Router {
     res.json({ ok: true });
   });
 
+  // Used by the browser extension: resolves the account behind an API token.
+  router.post('/account/lookup', async (req, res) => {
+    const account = await db
+      .collection<Account>('accounts')
+      .findOne({ apiToken: req.body.token }, { projection: { name: 1, plan: 1 } });
+    if (!account) {
+      res.status(401).json({ error: 'invalid_token' });
+      return;
+    }
+    res.json({ id: account._id, name: account.name, plan: account.plan });
+  });
+
   return router;
 }
